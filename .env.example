# Clé API PRIM (https://prim.iledefrance-mobilites.fr → Mon compte → Mes jetons)
PRIM_API_KEY=ta_cle_prim_ici

# Secret mis dans l'URL du connecteur : https://prim.home.leodubosclard.com/mcp/<MCP_SECRET>
# Génère-le avec : openssl rand -hex 32
MCP_SECRET=change_moi_avec_une_longue_chaine_aleatoire

PORT=3000
HOST=0.0.0.0

# Durée de cache de l'info trafic (l'API a un quota journalier)
DISRUPTIONS_CACHE_SECONDS=120

# Optionnel, pour surcharger l'URL de base PRIM
# PRIM_BASE_URL=https://prim.iledefrance-mobilites.fr/marketplace

